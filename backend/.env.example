# Prefer discrete vars on EasyPanel (they override DATABASE_URL).
POSTGRES_HOST=db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=naffas
# Or paste the Postgres Credentials "internal connection URL":
DATABASE_URL=postgresql://postgres:pass@db:5432/naffas
GOOGLE_SHEETS_WEBHOOK_URL=
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
TIKTOK_PIXEL_ID=
TIKTOK_ACCESS_TOKEN=
SNAP_PIXEL_ID=
SNAP_CAPI_TOKEN=
FRONTEND_ORIGIN=https://naffas.shop
API_PUBLIC_URL=https://api.naffas.shop
SHOP_PUBLIC_URL=https://naffas.shop
# Stripe (test keys start with sk_test_ / whsec_…)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
US_SHIPPING_USD=5.99
FREE_SHIPPING_THRESHOLD_USD=100
# Mojourney — required for admin login (no default password)
MOJOURNEY_ADMIN_USER=admin
MOJOURNEY_ADMIN_PASSWORD=
# Optional: long random key for API/scripts
ADMIN_API_KEY=
